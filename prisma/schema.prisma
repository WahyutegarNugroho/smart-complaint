generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  nik                String?
  name               String
  username           String         @unique
  role               Role           @default(MASYARAKAT)
  phone              String?
  address            String?
  rt                 String?
  rw                 String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  isVerified         Boolean        @default(false)
  @@index([role])
  @@index([isVerified])
  @@index([role, isVerified])
  announcements      Announcement[]
  auditLogs          AuditLog[]
  assignedComplaints Complaint[]    @relation("ComplaintAssignee")
  complaints         Complaint[]    @relation("ComplaintAuthor")
  notifications      Notification[]
  responses          Response[]
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  icon        String?
  parentId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  complaints  Complaint[]

  @@index([parentId])
  @@index([slug])
}

model Complaint {
  id              String          @id @default(cuid())
  title           String
  content         String
  incidentDate    DateTime
  location        String
  imageUrl        String?
  status          Status          @default(PENDING)
  authorId        String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isUrgent        Boolean         @default(false)
  rt              String?
  rw              String?
  category        String          @default("umum")
  assignedToId    String?
  escalatedAt     DateTime?
  escalationLevel EscalationLevel @default(NONE)
  latitude        Float?
  longitude       Float?
  categoryId      String?
  assignedTo      Profile?        @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  author          Profile         @relation("ComplaintAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  categoryRel     Category?       @relation(fields: [categoryId], references: [id])
  escalationLogs  EscalationLog[]
  responses       Response[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@index([rt])
  @@index([rw])
  @@index([category])
  @@index([categoryId])
  @@index([incidentDate])
  @@index([status, createdAt])
  @@index([status, isUrgent])
  @@index([authorId, status])
  @@index([category, status])
  @@index([latitude, longitude])
  @@index([escalationLevel])
  @@index([isUrgent])
  @@index([assignedToId])
}

model Response {
  id          String    @id @default(cuid())
  content     String
  complaintId String
  officerId   String
  createdAt   DateTime  @default(now())
  imageUrl    String?
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officer     Profile   @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([officerId])
  @@index([createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category  String   @default("umum")
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([category])
  @@index([authorId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  type      NotificationType @default(INFO)
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead, createdAt])
}

model EscalationLog {
  id          String          @id @default(cuid())
  complaintId String
  fromLevel   EscalationLevel
  toLevel     EscalationLevel
  reason      String
  createdAt   DateTime        @default(now())
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  adminId   String
  createdAt DateTime @default(now())
  admin     Profile  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([action])
  @@index([adminId])
}

enum Role {
  ADMIN
  PETUGAS
  MASYARAKAT
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
}

enum NotificationType {
  INFO
  WARNING
  DELETE
}

enum EscalationLevel {
  NONE
  LEVEL_1
  LEVEL_2
  LEVEL_3
}
